<Project>

  <!-- Imported by bottlenoselabs.Sdk.GameApp last, after Microsoft.NET.Sdk's targets -->

  <!-- Assets: copy everything under GameAssetsDirectory to the output and publish folders, keeping the folder structure -->
  <ItemGroup Condition=" '$(GameAssetsDirectory)' != '' ">
    <None Update="$(GameAssetsDirectory)/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Runtime marshalling off: P/Invoke calls into native libraries (such as SDL) pass blittable types straight through, with no hidden conversions or allocations.
       Set `IsEnabledRuntimeMarshalling` to `true` to turn it back on. -->
  <ItemGroup Condition=" '$(IsEnabledRuntimeMarshalling)' != 'true' ">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

  <!-- Icon, Windows manifest, and the platform's app format on publish -->
  <Import Project="$(MSBuildThisFileDirectory)Packaging/Packaging.targets" />

</Project>
