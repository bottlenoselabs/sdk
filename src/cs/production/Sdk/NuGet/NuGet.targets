<Project>

  <!-- Package ID: set PackageIdPrefix (for example `acme.`) to prefix every package ID that isn't set explicitly -->
  <PropertyGroup Condition=" '$(PackageIdPrefix)' != '' AND ('$(PackageId)' == '' OR '$(PackageId)' == '$(AssemblyName)') ">
    <PackageId>$(PackageIdPrefix)$(AssemblyName)</PackageId>
  </PropertyGroup>

</Project>
