<Project>

  <!-- Wrapped Sdk: our early targets need the project file but must come before Microsoft.NET.Sdk.Web -->
  <Import Project="$(_BottlenoseLabsSdkContentDirectoryPath)/Compilation/Compilation.targets" />

  <!-- Then Microsoft.NET.Sdk.Web, then our targets come last -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />

  <Import Project="$(_BottlenoseLabsSdkContentDirectoryPath)/Sdk.targets" />

</Project>
