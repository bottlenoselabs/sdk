<Project>

  <!-- This repository's own projects use Microsoft.NET.Sdk directly, so import the shared SDK content, not a wrapper -->
  <PropertyGroup>
    <_BottlenoseLabsSdkContentDirectoryPath>$(MSBuildThisFileDirectory)production/Sdk</_BottlenoseLabsSdkContentDirectoryPath>
  </PropertyGroup>
  <Import Project="$(_BottlenoseLabsSdkContentDirectoryPath)/Sdk.props" />

</Project>
