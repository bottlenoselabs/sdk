<Project>

  <!-- This repository's own projects use Microsoft.NET.Sdk directly, so import the shared SDK content, not a wrapper -->
  <PropertyGroup>
    <_BottlenoseLabsSdkContentDirectoryPath>$(MSBuildThisFileDirectory)production/Sdk</_BottlenoseLabsSdkContentDirectoryPath>
  </PropertyGroup>
  <Import Project="$(_BottlenoseLabsSdkContentDirectoryPath)/Sdk.props" />

  <!-- Identity of this repository's packages. The SDKs set none of this for other projects -->
  <PropertyGroup>
    <Company>bottlenoselabs</Company>
    <Authors>bottlenoselabs</Authors>
    <Copyright>© $([System.DateTime]::Now.ToString(yyyy)) Bottlenose Labs Inc.</Copyright>
    <PackageIdPrefix>bottlenoselabs.</PackageIdPrefix>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bottlenoselabs/sdk</PackageProjectUrl>
  </PropertyGroup>

</Project>
