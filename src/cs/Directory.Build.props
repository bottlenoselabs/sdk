<Project>

  <!-- This repository's own projects use Microsoft.NET.Sdk directly, so import the Sdk content, not the wrapper -->
  <PropertyGroup>
    <_BottlenoseLabsSdkDirectoryPath>$(MSBuildThisFileDirectory)production/Sdk</_BottlenoseLabsSdkDirectoryPath>
    <_BottlenoseLabsSdkContentDirectoryPath>$(_BottlenoseLabsSdkDirectoryPath)</_BottlenoseLabsSdkContentDirectoryPath>
  </PropertyGroup>
  <Import Project="$(_BottlenoseLabsSdkContentDirectoryPath)/Sdk.props" />

</Project>
