<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local folder feed: output of `dotnet pack` on Sdk -->
    <add key="local" value="../../../../nupkg" />
    <!-- NativeAOT compiler packages -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- The SDK under test must only come from the local feed, never from nuget.org -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="bottlenoselabs.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <!-- Keep restored packages local so a re-packed version is never served from the global cache -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
