<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local folder feed: output of `dotnet pack` on Sdk -->
    <add key="local" value="../../../../nupkg" />
  </packageSources>
  <config>
    <!-- Keep restored packages local so a re-packed version is never served from the global cache -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
